root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
# Two trailing spaces are a line break in markdown, and this repo is almost all
# prose — trimming them changes rendered text.
trim_trailing_whitespace = false
max_line_length = 80

[*.{json,yml,yaml,toml}]
indent_size = 2
